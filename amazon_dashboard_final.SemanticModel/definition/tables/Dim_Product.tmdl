	partition Dim_Product = m
		mode: import
		source =
				let
				    Source = products,
				    RemoveLinks = Table.RemoveColumns(Source, {"public.category", "public.sellers", "seller_id"}, MissingField.Ignore),
				    MergeCat = Table.NestedJoin(RemoveLinks, {"category_id"}, category, {"category_id"}, "cat", JoinKind.LeftOuter),
				    ExpandCat = Table.ExpandTableColumn(MergeCat, "cat", {"category_name"})
				in
				    ExpandCat

