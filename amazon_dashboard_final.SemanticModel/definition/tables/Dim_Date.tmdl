	column YearMonth
		formatString: 0
		lineageTag: 629f2453-03af-4a51-9e6c-6eb43ca686ed
		summarizeBy: none
		isNameInferred
		sourceColumn: [YearMonth]

		annotation SummarizationSetBy = Automatic

	partition Dim_Date = calculated
		mode: import
		source =
				
				VAR MinYear = YEAR ( MIN ( Fact_Sales[order_date] ) )
				VAR MaxYear = YEAR ( MAX ( Fact_Sales[order_date] ) )
				RETURN
				ADDCOLUMNS (
				    CALENDAR ( DATE ( MinYear, 1, 1 ), DATE ( MaxYear, 12, 31 ) ),
				    "Year", YEAR ( [Date] ),
				    "Month No", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "MMM" ),
				    "Month Year", FORMAT ( [Date], "MMM YYYY" ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "YearMonth", YEAR ( [Date] ) * 100 + MONTH ( [Date] )
				)

	annotation PBI_Id = 9cf3b6fc546249589da8a4294a4cf90a

