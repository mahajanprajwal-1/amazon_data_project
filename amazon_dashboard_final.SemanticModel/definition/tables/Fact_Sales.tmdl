	column 'Days to Ship'
		dataType: int64
		formatString: 0
		lineageTag: 01e3058a-93ce-4eb0-ade7-e9a33c0827a3
		summarizeBy: sum
		sourceColumn: Days to Ship

		annotation SummarizationSetBy = Automatic

	partition Fact_Sales = m
		mode: import
		source =
				let
				    Source = order_items,
				    RemoveLinks = Table.RemoveColumns(Source, {"public.orders", "public.products"}, MissingField.Ignore),
				
				    MergeOrders = Table.NestedJoin(RemoveLinks, {"order_id"}, orders, {"order_id"}, "ord", JoinKind.LeftOuter),
				    ExpandOrders = Table.ExpandTableColumn(MergeOrders, "ord",
				        {"order_date", "customer_id", "order_status", "seller_id"}),
				
				    MergePayments = Table.NestedJoin(ExpandOrders, {"order_id"}, payments, {"order_id"}, "pay", JoinKind.LeftOuter),
				    ExpandPayments = Table.ExpandTableColumn(MergePayments, "pay",
				        {"payment_mode", "payment_status", "payment_date"}),
				
				    MergeShipping = Table.NestedJoin(ExpandPayments, {"order_id"}, shipping, {"order_id"}, "ship", JoinKind.LeftOuter),
				    ExpandShipping = Table.ExpandTableColumn(MergeShipping, "ship",
				        {"delivery_status", "shipping_date", "return_date"}),
				
				    AddDaysToShip = Table.AddColumn(ExpandShipping, "Days to Ship",
				        each if [shipping_date] = null or [order_date] = null then null
				             else Duration.Days(Date.From([shipping_date]) - Date.From([order_date])),
				        Int64.Type)
				in
				    AddDaysToShip

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

